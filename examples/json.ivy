--------------------------------------------------------------------------------
---
--- Module       : json
--- Author       : Gerardo Torres Castro
--- Date         : September 6, 2026
---
--- A small JSON parser in Ivy: recursive descent over [Char]
--- Supports null, booleans, integers, strings (no escapes), arrays, objects.
---
-------------------------------------------------------------------------------


type Json =
    | JNull
    | JBool(Bool)
    | JNum(Int)
    | JStr(String)
    | JArr([Json])
    | JObj([(String, Json)]);

type Parsed<a> = { value: a, rest: [Char] };

fn ok(v: a, r: [Char]): Option<Parsed<a>> => Some(Parsed { value: v, rest: r });

fn andThen(None, f: a -> Option<b>): Option<b> => None;
fn andThen(Some(x), f: a -> Option<b>): Option<b> => f(x);

fn orElse(Some(x), _: Option<a>): Option<a> => Some(x);
fn orElse(None, alt: Option<a>): Option<a> => alt;

fn skipWhitespace([]): [Char] => [];
fn skipWhitespace([c | cs]): [Char] => if isWhitespace(c) then skipWhitespace(cs) else [c | cs];

fn matchKeyword(cs: [Char], []): Option<[Char]> => Some(cs);
fn matchKeyword([], [_ | _]): Option<[Char]> => None;
fn matchKeyword([c | cs], [k | ks]): Option<[Char]> => if c == k then matchKeyword(cs, ks) else None;

fn parseDigits([], acc: Int): Parsed<Int> => Parsed { value: acc, rest: [] };
fn parseDigits([c | cs], acc: Int): Parsed<Int> =>
  if isDigit(c) then parseDigits(cs, acc * 10 + digitToInt(c))
  else Parsed { value: acc, rest: [c | cs] };

fn parseStr([], acc: String): Parsed<String> => Parsed { value: acc, rest: [] };
fn parseStr(['"' | cs], acc: String): Parsed<String> => Parsed { value: acc, rest: cs };
fn parseStr([c | cs], acc: String): Parsed<String> => parseStr(cs, acc ++ charToString(c));

fn keyword(cs: [Char], word: String, val: Json): Option<Parsed<Json>> =>
  match matchKeyword(cs, chars(word)) with
  | Some(rest) -> ok(val, rest)
  | None -> None
end;

fn parseValue(input: [Char]): Option<Parsed<Json>> => match skipWhitespace(input) with
  | [] -> None
  | ['"' | rest] -> let s = parseStr(rest, "") in ok(JStr(s.value), s.rest)
  | ['[' | rest] -> parseArray(rest)
  | ['{' | rest] -> parseObject(rest)
  | ['-' | rest] -> let n = parseDigits(rest, 0) in ok(JNum(0 - n.value), n.rest)
  | [c | rest] ->
      if isDigit(c) then let n = parseDigits([c | rest], 0) in ok(JNum(n.value), n.rest)
      else orElse(keyword([c | rest], "true", JBool(true)),
           orElse(keyword([c | rest], "false", JBool(false)),
                  keyword([c | rest], "null", JNull)))
end;

fn parseArray(input: [Char]): Option<Parsed<Json>> => match skipWhitespace(input) with
  | [']' | rest] -> ok(JArr([]), rest)
  | cs -> parseArrayElems(cs, [])
end;

fn parseArrayElems(cs: [Char], acc: [Json]): Option<Parsed<Json>> =>
  andThen(parseValue(cs), fn (p) =>
    match skipWhitespace(p.rest) with
    | [',' | more] -> parseArrayElems(more, concat(acc, [p.value]))
    | [']' | more] -> ok(JArr(concat(acc, [p.value])), more)
    | _ -> None
    end);

fn parseObject(input: [Char]): Option<Parsed<Json>> => match skipWhitespace(input) with
  | ['}' | rest] -> ok(JObj([]), rest)
  | cs -> parseObjectEntries(cs, [])
end;

fn parseObjectEntries(input: [Char], acc: [(String, Json)]): Option<Parsed<Json>> =>
  match skipWhitespace(input) with
  | ['"' | rest] ->
      let k = parseStr(rest, "") in
      match skipWhitespace(k.rest) with
      | [':' | more] -> andThen(parseValue(more), fn (v) =>
          match skipWhitespace(v.rest) with
          | [',' | more2] -> parseObjectEntries(more2, concat(acc, [(k.value, v.value)]))
          | ['}' | more2] -> ok(JObj(concat(acc, [(k.value, v.value)])), more2)
          | _ -> None
          end)
      | _ -> None
      end
  | _ -> None
end;

fn parse(s: String): Option<Json> =>
  andThen(parseValue(chars(s)), fn (p) => Some(p.value));

fn showJson(JNull): String => "null";
fn showJson(JBool(b)): String => show(b);
fn showJson(JNum(n)): String => show(n);
fn showJson(JStr(s)): String => "\"" ++ s ++ "\"";
fn showJson(JArr(xs)): String => "[" ++ showJsonList(xs) ++ "]";
fn showJson(JObj(kvs)): String => "{" ++ showJsonObj(kvs) ++ "}";

fn showJsonList([]): String => "";
fn showJsonList([x]): String => showJson(x);
fn showJsonList([x | xs]): String => showJson(x) ++ "," ++ showJsonList(xs);

fn showJsonObj([]): String => "";
fn showJsonObj([(k, v)]): String => "\"" ++ k ++ "\":" ++ showJson(v);
fn showJsonObj([(k, v) | rest]): String => "\"" ++ k ++ "\":" ++ showJson(v) ++ "," ++ showJsonObj(rest);

fn showResult(None): String => "parse error";
fn showResult(Some(j)): String => showJson(j);

println(showResult(parse("null")));
println(showResult(parse("[1, 2, 3]")));
println(showResult(parse("{\"name\": \"ivy\", \"nums\": [10, -5], \"ok\": true}")));
println(showResult(parse("[[1], [2, 3], []]")));
